generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ArtigoCategory {
  PROVAS_DIGITAIS
  PROCESSO_PENAL
  INVESTIGACAO_DEFENSIVA
  CIBERCRIMES
  ANALISES
}

enum PublicacaoTipo {
  MIDIA
  PUBLICACAO_ACADEMICA
}

enum EventoTipo {
  PALESTRA
  CURSO
  CONGRESSO
  MESA
}

enum FaqCategory {
  GERAL
  PROVAS_DIGITAIS
  INVESTIGACAO
  HONORARIOS
}

// ─── Models ──────────────────────────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Artigo {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  content     String
  excerpt     String
  category    ArtigoCategory
  coverImage  String?
  status      ContentStatus  @default(DRAFT)
  featured    Boolean        @default(false)
  publishedAt DateTime?
  author      String         @default("Dellano Sousa")
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, publishedAt])
  @@index([slug])
}

model Publicacao {
  id        String         @id @default(cuid())
  title     String
  venue     String
  tipo      PublicacaoTipo
  url       String?
  date      String
  status    ContentStatus  @default(PUBLISHED)
  order     Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([tipo, status])
}

model Imprensa {
  id          String        @id @default(cuid())
  outlet      String
  title       String
  date        String
  url         String?
  description String?
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
}

model Evento {
  id          String        @id @default(cuid())
  title       String
  tipo        EventoTipo
  organizer   String
  location    String
  date        String
  role        String?
  description String?
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tipo, status])
}

model MembroEquipe {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String
  photo     String?
  oab       String?
  linkedin  String?
  hierarchy String
  expertise String[]
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FaqItem {
  id        String      @id @default(cuid())
  category  FaqCategory
  question  String
  answer    String
  order     Int         @default(0)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([category, active])
}

model SobrePage {
  id          String   @id @default(cuid())
  bioText     String
  credentials String[]
  lectures    String[]
  updatedAt   DateTime @updatedAt
}

model PageSeo {
  id          String   @id @default(cuid())
  pageKey     String   @unique
  title       String
  description String
  ogTitle     String?
  ogDesc      String?
  noIndex     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}
