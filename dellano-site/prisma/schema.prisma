generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PublicacaoTipo {
  MIDIA
  PUBLICACAO_ACADEMICA
}

enum EventoTipo {
  PALESTRA
  CURSO
  CONGRESSO
  MESA
}

enum FaqCategory {
  GERAL
  PROVAS_DIGITAIS
  INVESTIGACAO
  HONORARIOS
}

enum SiteKey {
  PRINCIPAL
  MARCA
  PERITO
  PROVA_DIGITAL
  CRIMINAL
  CRIMINAL_CE
}

// ─── Models ──────────────────────────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Artigo {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  content     String
  excerpt     String
  categoryId  String
  categoria   Categoria       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags        Tag[]           @relation("ArtigoTags")
  coverImage  String?
  status      ContentStatus   @default(DRAFT)
  featured    Boolean         @default(false)
  publishedAt DateTime?
  author      String          @default("Dellano Sousa")
  seoTitle    String?
  seoDesc     String?
  sites       SiteKey[]       @default([PRINCIPAL, MARCA, PERITO, PROVA_DIGITAL, CRIMINAL, CRIMINAL_CE])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, publishedAt])
  @@index([slug])
  @@index([categoryId])
}

model Categoria {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  artigos   Artigo[]

  @@index([order])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  artigos   Artigo[] @relation("ArtigoTags")
}

model Publicacao {
  id        String         @id @default(cuid())
  title     String
  venue     String
  tipo      PublicacaoTipo
  url       String?
  date      String
  status    ContentStatus  @default(PUBLISHED)
  order     Int            @default(0)
  sites     SiteKey[]      @default([PRINCIPAL, MARCA, PERITO, PROVA_DIGITAL, CRIMINAL, CRIMINAL_CE])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([tipo, status])
}

model Imprensa {
  id          String        @id @default(cuid())
  outlet      String
  title       String
  date        String
  url         String?
  description String?
  status      ContentStatus @default(PUBLISHED)
  sites       SiteKey[]     @default([PRINCIPAL, MARCA, PERITO, PROVA_DIGITAL, CRIMINAL, CRIMINAL_CE])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
}

model Evento {
  id          String        @id @default(cuid())
  title       String
  tipo        EventoTipo
  organizer   String
  location    String
  date        String
  role        String?
  description String?
  status      ContentStatus @default(PUBLISHED)
  sites       SiteKey[]     @default([PRINCIPAL, MARCA, PERITO, PROVA_DIGITAL, CRIMINAL, CRIMINAL_CE])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tipo, status])
}

model MembroEquipe {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String
  photo     String?
  oab       String?
  linkedin  String?
  hierarchy String
  expertise String[]
  order     Int      @default(0)
  active    Boolean  @default(true)
  sites     SiteKey[] @default([PRINCIPAL, MARCA, PERITO, PROVA_DIGITAL, CRIMINAL, CRIMINAL_CE])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

model FaqItem {
  id        String      @id @default(cuid())
  category  FaqCategory
  question  String
  answer    String
  order     Int         @default(0)
  active    Boolean     @default(true)
  sites     SiteKey[]   @default([PRINCIPAL, MARCA, PERITO, PROVA_DIGITAL, CRIMINAL, CRIMINAL_CE])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([category, active])
}

model SobrePage {
  id          String   @id @default(cuid())
  siteKey     SiteKey  @unique @default(PRINCIPAL)
  bioText     String
  credentials String[]
  lectures    String[]
  updatedAt   DateTime @updatedAt
}

model PageSeo {
  id          String   @id @default(cuid())
  siteKey     SiteKey  @default(PRINCIPAL)
  pageKey     String
  title       String
  description String
  ogTitle     String?
  ogDesc      String?
  noIndex     Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@unique([siteKey, pageKey])
  @@index([siteKey])
}
